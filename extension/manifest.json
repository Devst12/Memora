{
  "manifest_version": 3,
  "name": "Memora — Save to Memory",
  "version": "1.1.0",
  "description": "Save anything with one click — a floating save button on every page.",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": [],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Save to Memora", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" }
}
